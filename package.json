{
  "name": "amical",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,mts,css,mdx}\"",
    "format:check": "turbo run format:check",
    "type:check": "turbo run type:check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:ui": "turbo run test:ui"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@types/minimatch": "3.0.5",
      "@electron/windows-sign": "2.1.0"
    },
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "esbuild",
      "keytar",
      "protobufjs",
      "sharp",
      "@amical/whisper-wrapper",
      "better-sqlite3"
    ],
    "onlyBuiltDependencies": [
      "@posthog/cli",
      "electron",
      "electron-winstaller",
      "@amical/whisper-wrapper",
      "macos-alias",
      "fs-xattr",
      "onnxruntime-node",
      "jest-worker"
    ],
    "patchedDependencies": {
      "macos-alias@0.2.12": "patches/macos-alias@0.2.12.patch",
      "fs-xattr@0.3.1": "patches/fs-xattr@0.3.1.patch",
      "@electron/packager@18.4.2": "patches/electron-packager@18.4.2.patch"
    }
  }
}
